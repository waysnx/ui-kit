        {
          "id": "tree-w3c-keyboard-pattern",
          "priority": "P1",
          "title": "Tree doesn't implement W3C compliant keyboard navigation",
          "description": "Tree component lacks full W3C ARIA tree pattern keyboard support. Arrow keys should move focus between tree items and expand/collapse nodes, but current implementation only supports Tab-based focus. Does not implement aria-activedescendant for managed focus.",
          "actualBehavior": "Only Tab navigation moves focus between tree items. ArrowRight/ArrowLeft do not work. Users must use mouse to expand/collapse nodes or Tab through all items.",
          "expectedBehavior": "W3C ARIA tree pattern (https://www.w3.org/WAI/ARIA/apg/patterns/treeview/): ArrowRight expands focused node (if collapsed), ArrowLeft collapses it (if expanded). Up/Down arrow keys move focus to previous/next visible item. Implement aria-activedescendant on tree root to track keyboard focus.",
          "userImpact": "Keyboard-only and screen reader users cannot efficiently navigate tree hierarchies without mouse. Violates WCAG 2.1.1 (Keyboard) accessibility requirement.",
          "verificationMethod": "Code inspection of keyboard event handlers; testing with keyboard and screen reader; W3C ARIA tree pattern specification verification",
          "verificationConfidence": "Code-reviewed",
          "wcagCriteria": ["2.1.1 Keyboard", "4.1.2 Name, Role, Value"]
        },
        {
          "id": "tree-aria-activedescendant",
          "priority": "P2",
          "title": "Missing aria-activedescendant for keyboard focus management",
          "description": "Tree component lacks aria-activedescendant attribute on tree root, which is required by W3C ARIA pattern for managed focus trees. Screen readers cannot track programmatic focus.",
          "actualBehavior": "Tree root element does not have aria-activedescendant; keyboard focus moves visually but screen reader doesn't know which item is focused.",
          "expectedBehavior": "Set aria-activedescendant on tree root element to current focused item's ID when using keyboard navigation.",
          "userImpact": "Screen reader users lose focus context when navigating tree with arrow keys.",
          "verificationMethod": "Code inspection of aria-activedescendant implementation; screen reader testing",
          "verificationConfidence": "Code-reviewed"
        }
      ],
      "decision": "Improve",
      "reasoning": "Tree component has basic ARIA roles (tree, treeitem, aria-expanded) but is missing W3C compliant keyboard navigation pattern and aria-activedescendant. Requires implementation of arrow key handlers and focus management."
